# Copy on EC2 (no secrets):
#   cp deploy/bot.env.example deploy/bot.env
#
# Kotak API keys, MPIN, and UI login are loaded from AWS SSM Parameter Store
# when the EC2 instance role has ssm:GetParameter on /trade/config/...

BROKER_BACKEND=kotak
AWS_REGION=ap-south-1
KOTAK_ENVIRONMENT=prod
KOTAK_TOTP_UI=true
WEB_UI_PORT=8002
BOT_LOG_PATH=/home/ec2-user/bot-lite-kotak/bot.log

# Optional overrides (defaults are in config.py)
# SSM_LOGIN_USERNAME_PATH=/trade/config/5pindra/loginusername
# SSM_LOGIN_PASSWORD_PATH=/trade/config/5pindra/loginpassword
# SSM_KOTAK_BASE_PATH=/trade/config/kotak/rajesh
# KOTAK_SSM_PROFILE=rajesh

# Do NOT put KOTAK_CONSUMER_KEY_S, MPIN, passwords, or KOTAK_TOTP here.
