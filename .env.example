# Copy to .env and fill in values:
#   cp .env.example .env
#
# Local Kotak run: set BROKER_BACKEND=kotak and the KOTAK_* variables below.
# Do not commit .env (it is gitignored).

# --- Broker ---
BROKER_BACKEND=kotak

# --- Kotak Neo API (required for BROKER_BACKEND=kotak) ---
# Consumer key from Kotak Neo / developer portal (used as API Authorization header).
KOTAK_CONSUMER_KEY_S=

# Registered mobile, e.g. +9198xxxxxxx (format as required by Kotak).
KOTAK_MOBILE_S=

# Unique client code (UCC) from profile.
KOTAK_UCC_S=

# 6-digit MPIN for totp_validate.
KOTAK_MPIN_S=

# Base32 setup key (from authenticator registration — letters A–Z and digits 2–7 only).
# NOT the 6-digit code that changes every 30 seconds.
# You can paste a full otpauth://totp/...?secret=...&issuer=... URI here.
KOTAK_TOTP_SECRET=

# Optional: current 6-digit code for a one-off login test (remove after; bot cannot auto-refresh).
# KOTAK_TOTP=

# prod | uat
KOTAK_ENVIRONMENT=prod

# Optional: Kotak neo-fin-key override (defaults in SDK if unset).
# KOTAK_NEO_FIN_KEY=

# Optional: re-login after N seconds (0 = only when session missing).
# KOTAK_SESSION_MAX_AGE_SEC=0

# --- UI basic auth (Flask dashboard) ---
LOGIN_USERNAME_5P=admin
LOGIN_PASSWORD_5P=changeme

# Or override with:
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=

# --- Optional: AWS SSM (only if you load secrets from Parameter Store) ---
# If unset, all secrets must be present in this file or the environment.
# ACC_NAME=your_account_slug

# --- Optional ---
# DEMO_MODE=true
# BOT_LOG_PATH=
