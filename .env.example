# Copy to .env and fill in values:
#   cp .env.example .env
#
# Local Kotak run: set BROKER_BACKEND=kotak and the KOTAK_* variables below.
# Do not commit .env (it is gitignored).

# --- Broker ---
BROKER_BACKEND=kotak

# --- Kotak Neo API (required for BROKER_BACKEND=kotak) ---
# Consumer key from Kotak Neo / developer portal (used as API Authorization header).
KOTAK_CONSUMER_KEY_S=

# Registered mobile, e.g. +9198xxxxxxx (format as required by Kotak).
KOTAK_MOBILE_S=

# Unique client code (UCC) from profile.
KOTAK_UCC_S=

# 6-digit MPIN for totp_validate.
KOTAK_MPIN_S=

# Base32 setup key (from authenticator registration — letters A–Z and digits 2–7 only).
# NOT the 6-digit code that changes every 30 seconds.
# You can paste a full otpauth://totp/...?secret=...&issuer=... URI here.
KOTAK_TOTP_SECRET=

# Do NOT set KOTAK_TOTP when using dashboard TOTP (KOTAK_TOTP_UI=true, default).
# A stale 6-digit value here causes "Invalid TOTP" errors until removed.
# Optional one-shot for scripts only:
# KOTAK_TOTP=

# prod | uat
KOTAK_ENVIRONMENT=prod

# Optional: Kotak neo-fin-key override (defaults in SDK if unset).
# KOTAK_NEO_FIN_KEY=

# Optional: re-login after N seconds (0 = only when session missing).
# KOTAK_SESSION_MAX_AGE_SEC=0

# --- UI basic auth (Flask dashboard) ---
LOGIN_USERNAME_5P=admin
LOGIN_PASSWORD_5P=changeme

# Or override with:
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=

# --- AWS SSM (EC2 production; IAM role needs ssm:GetParameter) ---
# Defaults match Parameter Store layout — override only if paths differ.
# SSM_BASE_PATH=/trade/config
# AWS_REGION=ap-south-1
# SSM_LOGIN_USERNAME_PATH=/trade/config/5pindra/loginusername
# SSM_LOGIN_PASSWORD_PATH=/trade/config/5pindra/loginpassword
# SSM_KOTAK_BASE_PATH=/trade/config/kotak/rajesh
# KOTAK_SSM_PROFILE=rajesh
# Optional TOTP on SSM: /trade/config/kotak/rajesh/KOTAK_TOTP_SECRET
# If no secret, enter TOTP once per day in the dashboard after login (IST).
# KOTAK_TOTP_UI=true
# KOTAK_FORCE_UI_TOTP=false
# Legacy XTS only: ACC_NAME=your_account_slug

# --- Optional ---
# DEMO_MODE=true
# BOT_LOG_PATH=
